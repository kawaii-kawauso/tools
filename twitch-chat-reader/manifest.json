{
  "manifest_version": 3,
  "name": "Twitch Chat Reader",
  "version": "0.1.0",
  "description": "Twitchの配信ページを開いている間、そのチャンネルのコメントを読み上げる",
  "permissions": [
    "tts",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.twitch.tv/*",
        "https://dashboard.twitch.tv/*"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-reading": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "読み上げのON/OFFを切り替える",
      "global": true
    },
    "stop-reading": {
      "suggested_key": {
        "default": "Ctrl+Shift+8"
      },
      "description": "読んでいるコメントと待ちを止める",
      "global": true
    }
  },
  "host_permissions": [
    "http://localhost/*"
  ]
}
